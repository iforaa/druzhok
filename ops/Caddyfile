# Druzhok dashboard. Must be a more specific host than the wildcard below,
# and PHX_HOST in /etc/druzhok/druzhok.env must match it.
druzhok.oldey.dev {
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  }
  encode zstd gzip
  reverse_proxy 127.0.0.1:4000
}

# Apex + wildcard are owned by the RuOC gateway (CleoCode) since 2026-08-29.
# Bot sites (<bot>.oldey.dev, BotSite plug) are therefore NOT reachable
# until they get their own sub-wildcard.
oldey.dev, *.oldey.dev {
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  }
  encode zstd gzip
  reverse_proxy 127.0.0.1:8787
}
