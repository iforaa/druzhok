# Druzhok: the LLM proxy, Telegram webhooks, /internal/fetch. Must be a more
# specific host than the wildcard below, and PHX_HOST in /etc/druzhok/druzhok.env must match it.
druzhok.oldey.dev {
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  }
  encode zstd gzip
  reverse_proxy 127.0.0.1:4000 {
    # `header_up X-Druzhok-Edge <secret>`, so only Caddy can reach druzhok's
    # /app (bots dial :4000 directly). The file is root:caddy 0640 and holds
    # the same value as DRUZHOK_EDGE_SECRET in /etc/druzhok/druzhok.env; an
    # import, not {env.*}, so a reload picks it up with no restart.
    import /etc/caddy/druzhok-edge.caddy
  }
}

# Triera landing (static, site/triera in the repo, rsynced to /data/triera).
triera.oldey.dev {
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  }
  encode zstd gzip
  root * /data/triera
  file_server
  header Cache-Control "no-cache"
}

# Apex + wildcard are owned by the RuOC gateway (CleoCode) since 2026-08-29.
# That includes bot sites: the gateway serves <slug>.oldey.dev itself.
oldey.dev, *.oldey.dev {
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  }
  encode zstd gzip
  reverse_proxy 127.0.0.1:8787
}

# CleoCode landing on its own domain: the gateway serves the site to any host
# it does not recognise, so this only needs to reach it. DNS is at reg.ru, no
# Cloudflare token, so the certificate comes from the plain HTTP challenge.
cleocode.ru, www.cleocode.ru {
  encode zstd gzip
  reverse_proxy 127.0.0.1:8787
}
