#!/usr/bin/env bash
# druzhok-ctl — the single privileged entry point Druzhok uses to manage
# per-bot Linux users + systemd units. Invoked as root via sudo.
#
#   create <name>      (env file on stdin)   useradd + data dir + env + nft + bind lock;
#                                            idempotent, re-run before every start to refresh env
#   start|stop|restart|destroy <name>
#   status <name>      → active|activating|inactive|failed|unknown
#   stats <name>       → <mem_bytes>|<cpu_usec>
#   logs <name> <n>
#   exec <name> <cmd> [args…]                run as the bot user
set -euo pipefail

TENANTS=/data/tenants
ENVDIR=/etc/druzhok
HERMES_BIN_DIR=/opt/hermes/.venv/bin
NFT_FAMILY=inet
NFT_TABLE=druzhok
NFT_SET=bot_uids
NFT_WEBHOOK_SET=bot_webhook
UNIT_DIR=/etc/systemd/system

die() { echo "druzhok-ctl: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ $# -ge 2 ] || die "usage: druzhok-ctl <cmd> <name> [args]"

cmd=$1; name=$2; shift 2
[[ "$name" =~ ^[a-z0-9][a-z0-9_-]{0,30}$ ]] || die "invalid bot name: $name"

user="bot-$name"
unit="hermes@$name.service"
root="$TENANTS/$name"
envf="$ENVDIR/$name.env"

user_exists() { id -u "$user" >/dev/null 2>&1; }
uid_of()      { id -u "$user"; }

write_env() {
  # stdin → $envf, atomically, root-only. Reject anything that isn't KEY="…" lines.
  local tmp
  tmp=$(mktemp "$ENVDIR/.$name.XXXXXX")
  cat > "$tmp"
  if grep -vqE '^[A-Z_][A-Z0-9_]*=".*"$' "$tmp"; then
    rm -f "$tmp"; die "env file must contain only KEY=\"value\" lines"
  fi
  chmod 0600 "$tmp"; chown root:root "$tmp"
  mv -f "$tmp" "$envf"
}

nft_add() {
  nft add element "$NFT_FAMILY" "$NFT_TABLE" "$NFT_SET" "{ $(uid_of) }" 2>/dev/null || true
}
nft_del() {
  local uid
  uid=$(uid_of) || return 0
  nft delete element "$NFT_FAMILY" "$NFT_TABLE" "$NFT_SET" "{ $uid }" 2>/dev/null || true
}

# The bot's Telegram webhook port (20000 + id), written by druzhok into the env
# file for every bot whatever its mode; empty when the id is out of range.
webhook_port() {
  sed -n 's/^TELEGRAM_WEBHOOK_PORT="\([0-9]\{1,5\}\)"$/\1/p' "$envf" 2>/dev/null | head -n 1
}

# Webhook relay port isolation (docs/superpowers/specs/2026-10-20-telegram-webhook-relay-design.md).
# Only the bot's own uid may answer druzhok from its own port: { uid . port }.
nft_webhook_add() {
  local port
  port=$(webhook_port)
  [ -n "$port" ] || return 0
  nft add element "$NFT_FAMILY" "$NFT_TABLE" "$NFT_WEBHOOK_SET" "{ $(uid_of) . $port }" 2>/dev/null || true
}
nft_webhook_del() {
  local uid port
  uid=$(uid_of) || return 0
  port=$(webhook_port)
  [ -n "$port" ] || return 0
  nft delete element "$NFT_FAMILY" "$NFT_TABLE" "$NFT_WEBHOOK_SET" "{ $uid . $port }" 2>/dev/null || true
}

# hermes and everything its terminal spawns share the unit's cgroup: they may
# bind(2) the bot's own webhook port and nothing else, so no bot can take
# another bot's port while that one restarts or sleeps. Written for every bot,
# polling ones included, since any bot is a potential squatter.
write_bind_lock() {
  local port dir conf tmp
  port=$(webhook_port)
  dir="$UNIT_DIR/$unit.d"
  conf="$dir/webhook.conf"
  install -d -m 0755 "$dir"
  tmp=$(mktemp "$dir/.webhook.XXXXXX")
  {
    echo "[Service]"
    if [ -n "$port" ]; then echo "SocketBindAllow=tcp:$port"; fi
    echo "SocketBindDeny=any"
  } > "$tmp"
  chmod 0644 "$tmp"
  if cmp -s "$tmp" "$conf"; then
    rm -f "$tmp"
  else
    mv -f "$tmp" "$conf"
    systemctl daemon-reload
  fi
}

case "$cmd" in
  create)
    if ! user_exists; then
      useradd --system --no-create-home --shell /usr/sbin/nologin --home-dir "$root" "$user"
    fi
    install -d -m 0700 -o "$user" -g "$user" "$root" "$root/home" "$root/workspace"
    # Data copied in from another host is root-owned; hand it to the bot.
    chown -R "$user:$user" "$root"
    mkdir -p "$ENVDIR"; chmod 0755 "$ENVDIR"
    write_env
    nft_add
    nft_webhook_add
    write_bind_lock
    ;;
  start|restart)
    user_exists || die "no such bot: $name"
    # Druzhok (CAP_DAC_OVERRIDE) may have created/rewritten files as its own
    # user; hand the whole tree back to the bot before it runs.
    chown -R "$user:$user" "$root"
    # The nft set is empty after an nftables reload (reboot, bootstrap): with
    # no uids in it every bot has open egress, so re-add on every start.
    nft_add
    nft_webhook_add
    systemctl "$cmd" "$unit"
    ;;
  stop)
    user_exists || die "no such bot: $name"
    systemctl stop "$unit"
    systemctl reset-failed "$unit" 2>/dev/null || true
    ;;
  status)
    if ! user_exists; then echo unknown; exit 0; fi
    st=$(systemctl is-active "$unit" 2>/dev/null || true)
    case "$st" in
      active|activating|inactive|failed) echo "$st";;
      *) echo inactive;;
    esac
    ;;
  stats)
    user_exists || die "no such bot: $name"
    cg="/sys/fs/cgroup$(systemctl show -p ControlGroup --value "$unit")"
    if [ -r "$cg/memory.current" ]; then
      mem=$(cat "$cg/memory.current")
      cpu=$(awk '/^usage_usec/ {print $2}' "$cg/cpu.stat")
      echo "${mem:-0}|${cpu:-0}"
    else
      echo "0|0"
    fi
    ;;
  logs)
    n=${1:-200}
    [[ "$n" =~ ^[0-9]+$ ]] || die "bad line count"
    journalctl -u "$unit" -n "$n" --no-pager -o cat 2>/dev/null || true
    ;;
  exec)
    user_exists || die "no such bot: $name"
    [ $# -ge 1 ] || die "exec needs a command"
    # Run as a transient unit so the env file is parsed by systemd exactly as
    # hermes@.service sees it (no second parser here), with the same HOME/PATH.
    # ExecSearchPath resolves the binary AND becomes $PATH (systemd ≥ 250).
    exec systemd-run --quiet --wait --pipe --collect \
      --uid="$user" --gid="$user" \
      -p EnvironmentFile="$envf" -p WorkingDirectory="$root/workspace" \
      -p ExecSearchPath="$HERMES_BIN_DIR" -p ExecSearchPath=/usr/local/bin \
      -p ExecSearchPath=/usr/bin -p ExecSearchPath=/bin \
      -E HOME="$root/home" \
      -- "$@" 2>&1
    ;;
  destroy)
    if user_exists; then
      systemctl stop "$unit" 2>/dev/null || true
      systemctl reset-failed "$unit" 2>/dev/null || true
      nft_del
      nft_webhook_del
      userdel "$user"
    fi
    rm -f "$envf"
    if [ -d "$UNIT_DIR/$unit.d" ]; then
      rm -f "$UNIT_DIR/$unit.d/webhook.conf"
      rmdir "$UNIT_DIR/$unit.d" 2>/dev/null || true
      systemctl daemon-reload
    fi
    ;;
  *)
    die "unknown command: $cmd"
    ;;
esac
