#!/usr/bin/env bash
# druzhok-ctl — the single privileged entry point Druzhok uses to manage
# per-bot Linux users + systemd units. Invoked as root via sudo.
#
#   create <name>      (env file on stdin)   useradd + data dir + env + nft; idempotent,
#                                            re-run before every start to refresh env
#   start|stop|restart|destroy <name>
#   status <name>      → active|activating|restarting|stopping|inactive|failed|unknown
#   stats <name>       → <mem_bytes>|<cpu_usec>
#   procs <name>       → number of processes in the unit's cgroup (0 when stopped)
#   logs <name> <n>
#   exec <name> <cmd> [args…]                run as the bot user (stdin is passed on)
#   purge <name>                             remove a destroyed bot's tenant dir
#   sync-nft                                 rewrite the saved nft set members (no name)
set -euo pipefail

TENANTS=/data/tenants
ENVDIR=/etc/druzhok
HERMES_BIN_DIR=/opt/hermes/.venv/bin
NFT_FAMILY=inet
NFT_TABLE=druzhok
NFT_SET=bot_uids
NFT_WEBHOOK_SET=bot_webhook
UNIT_DIR=/etc/systemd/system
CGROUP_ROOT=/sys/fs/cgroup
# The set members, saved where /etc/nftables.conf includes them. The name sorts
# after druzhok.nft (which declares the sets) in the include glob.
NFT_MEMBERS=/etc/nftables.d/druzhok.zz-members.nft

die() { echo "druzhok-ctl: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "must run as root"
# `sync-nft` is the one command without a bot name.
[ "${1:-}" = sync-nft ] && set -- sync-nft -
[ $# -ge 2 ] || die "usage: druzhok-ctl <cmd> <name> [args]"

cmd=$1; name=$2; shift 2
[ "$cmd" = sync-nft ] || [[ "$name" =~ ^[a-z0-9][a-z0-9_-]{0,30}$ ]] || die "invalid bot name: $name"
# A bot's env file is $ENVDIR/<name>.env, and druzhok.env there is the service's
# own, which ops/smoke.sh sources as root: no bot may be called that.
[ "$name" != druzhok ] || die "reserved bot name: $name"

user="bot-$name"
unit="hermes@$name.service"
root="$TENANTS/$name"
envf="$ENVDIR/$name.env"

user_exists() { id -u "$user" >/dev/null 2>&1; }
uid_of()      { id -u "$user"; }

write_env() {
  # stdin → $envf, atomically, root-only. Reject anything that isn't KEY="…" lines.
  local tmp
  tmp=$(mktemp "$ENVDIR/.$name.XXXXXX")
  cat > "$tmp"
  if grep -vqE '^[A-Z_][A-Z0-9_]*=".*"$' "$tmp"; then
    rm -f "$tmp"; die "env file must contain only KEY=\"value\" lines"
  fi
  chmod 0600 "$tmp"; chown root:root "$tmp"
  mv -f "$tmp" "$envf"
}

nft_add() {
  nft add element "$NFT_FAMILY" "$NFT_TABLE" "$NFT_SET" "{ $(uid_of) }" 2>/dev/null || true
}
nft_del() {
  local uid
  uid=$(uid_of) || return 0
  nft delete element "$NFT_FAMILY" "$NFT_TABLE" "$NFT_SET" "{ $uid }" 2>/dev/null || true
}

# The bot's Telegram webhook port (20000 + id), written by druzhok into the env
# file for every bot whatever its mode; empty when the id is out of range.
webhook_port() {
  sed -n 's/^TELEGRAM_WEBHOOK_PORT="\([0-9]\{1,5\}\)"$/\1/p' "$envf" 2>/dev/null | head -n 1
}

# Webhook relay port isolation (docs/superpowers/specs/2026-10-20-telegram-webhook-relay-design.md).
# Only the bot's own uid may answer druzhok from its own port: { uid . port }.
nft_webhook_add() {
  local port
  port=$(webhook_port)
  [ -n "$port" ] || return 0
  nft add element "$NFT_FAMILY" "$NFT_TABLE" "$NFT_WEBHOOK_SET" "{ $(uid_of) . $port }" 2>/dev/null || true
}
nft_webhook_del() {
  local uid port
  uid=$(uid_of) || return 0
  port=$(webhook_port)
  [ -n "$port" ] || return 0
  nft delete element "$NFT_FAMILY" "$NFT_TABLE" "$NFT_WEBHOOK_SET" "{ $uid . $port }" 2>/dev/null || true
}

# Write every bot's uid and { uid . webhook port } to $NFT_MEMBERS, from the
# users and env files as they are now. /etc/nftables.conf starts with `flush
# ruleset` and includes /etc/nftables.d/*.nft, so a reload loads the sets and
# their members in one transaction; without this file a reload left the sets
# empty, which is open egress for every running bot until its next start.
# Written through a dot name, which the include glob skips, then renamed, under
# a lock so two druzhok-ctl calls cannot rename an older snapshot over a newer one.
nft_persist() {
  local dir
  dir=$(dirname "$NFT_MEMBERS")
  mkdir -p "$dir"
  (
    if command -v flock >/dev/null 2>&1; then flock 9; fi
    nft_persist_locked
  ) 9>"$dir/.druzhok-members.lock"
}

nft_persist_locked() {
  local uids=() pairs=() uname uid n port tmp
  while IFS=: read -r uname _ uid _; do
    case "$uname" in bot-*) ;; *) continue ;; esac
    uids+=("$uid")
    n=${uname#bot-}
    # A bot user without an env file (half-made, half-deleted) still has its uid
    # saved; it just has no port. Never let it fail the script for every bot.
    port=$(sed -n 's/^TELEGRAM_WEBHOOK_PORT="\([0-9]\{1,5\}\)"$/\1/p' "$ENVDIR/$n.env" 2>/dev/null | head -n 1 || true)
    if [ -n "$port" ]; then pairs+=("$uid . $port"); fi
  done < <(getent passwd)
  tmp=$(mktemp "$(dirname "$NFT_MEMBERS")/.druzhok-members.XXXXXX")
  {
    echo "# Generated by druzhok-ctl (nft_persist): bot uids and webhook ports. Do not edit."
    if [ ${#uids[@]} -gt 0 ]; then
      echo "add element $NFT_FAMILY $NFT_TABLE $NFT_SET { $(IFS=,; echo "${uids[*]}") }"
    fi
    if [ ${#pairs[@]} -gt 0 ]; then
      echo "add element $NFT_FAMILY $NFT_TABLE $NFT_WEBHOOK_SET { $(IFS=,; echo "${pairs[*]}") }"
    fi
  } > "$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$NFT_MEMBERS"
}

# systemd's restart loop (Restart=always after a hermes that died) is
# ActiveState=activating with SubState=auto-restart, and a drain is
# deactivating; the lifecycle controller must tell both from a normal start
# and from stopped (sleep/wake spec, "Controller").
unit_status() {
  local active sub
  active=$(systemctl show -p ActiveState --value "$unit" 2>/dev/null || true)
  sub=$(systemctl show -p SubState --value "$unit" 2>/dev/null || true)
  case "$active" in
    activating) if [ "$sub" = auto-restart ]; then echo restarting; else echo activating; fi;;
    deactivating) echo stopping;;
    active|inactive|failed) echo "$active";;
    *) echo inactive;;
  esac
}

unit_procs() {
  local cg
  cg="$CGROUP_ROOT$(systemctl show -p ControlGroup --value "$unit" 2>/dev/null || true)"
  if [ "$cg" != "$CGROUP_ROOT" ] && [ -r "$cg/cgroup.procs" ]; then
    wc -l < "$cg/cgroup.procs" | tr -d ' '
  else
    echo 0
  fi
}

# Remove the systemd bind lock an earlier druzhok-ctl wrote: this box's
# systemd is built without BPF_FRAMEWORK, so SocketBindAllow/Deny were never
# enforced (webhook relay spec, "Port isolation").
remove_bind_lock() {
  local dir="$UNIT_DIR/$unit.d"
  [ -f "$dir/webhook.conf" ] || return 0
  rm -f "$dir/webhook.conf"
  rmdir "$dir" 2>/dev/null || true
  systemctl daemon-reload
}

# The bot's home and workspace, below a dir the bot owns. `install -d` (and
# chmod/chown by name) follows a symlink the bot planted there and would hand
# the bot whatever directory it points at, so these are only ever made with
# mkdir, which refuses an existing name; `chown -R` on the tree then gives
# them to the bot without following links.
tenant_dirs() {
  local d p
  for d in home workspace; do
    p="$root/$d"
    if [ -L "$p" ]; then die "$d is a symlink: $p"; fi
    if [ -e "$p" ] && [ ! -d "$p" ]; then die "$d is not a directory: $p"; fi
    [ -d "$p" ] || mkdir -m 0700 "$p"
  done
}

case "$cmd" in
  create)
    if ! user_exists; then
      useradd --system --no-create-home --shell /usr/sbin/nologin --home-dir "$root" "$user"
    fi
    install -d -m 0700 -o "$user" -g "$user" "$root"
    tenant_dirs
    # Data copied in from another host is root-owned; hand it to the bot.
    # -h: a link in it is chowned itself, never followed.
    chown -h -R "$user:$user" "$root"
    mkdir -p "$ENVDIR"; chmod 0755 "$ENVDIR"
    write_env
    nft_add
    nft_webhook_add
    nft_persist
    remove_bind_lock
    ;;
  start|restart)
    user_exists || die "no such bot: $name"
    # Data copied in by hand is root-owned; hand the whole tree to the bot
    # before it runs. -h: a link in it is chowned itself, never followed.
    chown -h -R "$user:$user" "$root"
    # bootstrap.sh deletes and reloads the druzhok table on its own, which
    # empties the sets: re-add this bot live on every start, then save the
    # members so a reload of /etc/nftables.conf brings them back too.
    nft_add
    nft_webhook_add
    nft_persist
    systemctl "$cmd" "$unit"
    ;;
  stop)
    user_exists || die "no such bot: $name"
    systemctl stop "$unit"
    systemctl reset-failed "$unit" 2>/dev/null || true
    ;;
  status)
    if ! user_exists; then echo unknown; exit 0; fi
    unit_status
    ;;
  procs)
    user_exists || die "no such bot: $name"
    unit_procs
    ;;
  stats)
    user_exists || die "no such bot: $name"
    cg="/sys/fs/cgroup$(systemctl show -p ControlGroup --value "$unit")"
    if [ -r "$cg/memory.current" ]; then
      mem=$(cat "$cg/memory.current")
      cpu=$(awk '/^usage_usec/ {print $2}' "$cg/cpu.stat")
      echo "${mem:-0}|${cpu:-0}"
    else
      echo "0|0"
    fi
    ;;
  logs)
    n=${1:-200}
    [[ "$n" =~ ^[0-9]+$ ]] || die "bad line count"
    journalctl -u "$unit" -n "$n" --no-pager -o cat 2>/dev/null || true
    ;;
  exec)
    user_exists || die "no such bot: $name"
    [ $# -ge 1 ] || die "exec needs a command"
    # Run as a transient unit so the env file is parsed by systemd exactly as
    # hermes@.service sees it (no second parser here), with the same HOME/PATH.
    # ExecSearchPath resolves the binary AND becomes $PATH (systemd ≥ 250).
    exec systemd-run --quiet --wait --pipe --collect \
      --uid="$user" --gid="$user" \
      -p EnvironmentFile="$envf" -p WorkingDirectory="$root/workspace" \
      -p ExecSearchPath="$HERMES_BIN_DIR" -p ExecSearchPath=/usr/local/bin \
      -p ExecSearchPath=/usr/bin -p ExecSearchPath=/bin \
      -E HOME="$root/home" \
      -- "$@" 2>&1
    ;;
  destroy)
    if user_exists; then
      systemctl stop "$unit" 2>/dev/null || true
      systemctl reset-failed "$unit" 2>/dev/null || true
      nft_del
      nft_webhook_del
      userdel "$user"
    fi
    nft_persist
    remove_bind_lock
    rm -f "$envf"
    ;;
  purge)
    # /data/tenants is root's, so druzhok cannot remove a tenant dir itself.
    # Only once the bot is destroyed: nothing runs as its user any more.
    if user_exists; then die "bot still exists: $name"; fi
    if [ -L "$root" ]; then die "tenant dir is a symlink: $root"; fi
    # rm never follows a link: one inside the tree is removed, not its target.
    rm -rf -- "$root"
    ;;
  sync-nft)
    nft_persist
    ;;
  *)
    die "unknown command: $cmd"
    ;;
esac
