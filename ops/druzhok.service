[Unit]
Description=Druzhok orchestrator (Phoenix)
After=network-online.target
Wants=network-online.target

[Service]
# Its own user, not the admin login `ubuntu`: `ubuntu` has passwordless sudo
# for everything, so a bug in an internet-facing service running as it is root
# on the box. `druzhok` may sudo only druzhok-ctl, tenant-fs and docs-convert
# (ops/sudoers-druzhok). The code tree is ubuntu's, not druzhok's, so it is
# compiled at deploy and never here, and druzhok cannot change what it runs.
User=druzhok
Group=druzhok
WorkingDirectory=/data/druzhok-app
# All prod env (MIX_ENV, DATABASE_PATH, DRUZHOK_HOST, HEX/MIX homes, secrets)
# lives in druzhok.env, shared with ops/druzhok-run.sh and ops/smoke.sh.
EnvironmentFile=/etc/druzhok/druzhok.env
Environment=PHX_SERVER=true PORT=4000
ExecStart=/bin/bash -c '. ops/runtime-env.sh && exec mix phx.server --no-compile --no-deps-check'
Restart=always
RestartSec=5
KillMode=mixed
# No capabilities: tenant dirs are 0700 bot-<name>, and druzhok reads and
# writes config.yaml, SOUL.md and the panel's files there through the
# tenant-fs helper, which does it as the bot's own user (Druzhok.TenantFiles).
# No CapabilityBoundingSet and no NoNewPrivileges either: both would also cap
# what setuid sudo can gain, and `sudo druzhok-ctl` then dies with "unable to
# change to root gid".

[Install]
WantedBy=multi-user.target
