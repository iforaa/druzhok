[Unit]
Description=Hermes bot %i
After=network-online.target druzhok.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=120
User=bot-%i
Group=bot-%i
# HERMES_HOME and all bot-specific vars come from the env file (Druzhok owns it).
EnvironmentFile=/etc/druzhok/%i.env
Environment=HOME=/data/tenants/%i/home
Environment=PATH=/opt/hermes/.venv/bin:/usr/local/bin:/usr/bin:/bin
# glibc gives each thread that mallocs its own 64 MB arena; hermes runs ~26
# threads, so an idle bot's RSS creeps up for days. Two arenas cap that.
Environment=MALLOC_ARENA_MAX=2
WorkingDirectory=/data/tenants/%i/workspace
ExecStart=/opt/hermes/.venv/bin/hermes gateway run
Restart=always
RestartSec=5
TimeoutStartSec=300
KillMode=mixed

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data/tenants/%i
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# A bot sees only its own processes in /proc, and no host-wide files there
# (/proc/meminfo, /proc/stat, /proc/net, /proc/sys). `ps`, `free` and `uptime` do
# not work in its terminal. ProcSubset has a cost: psutil's children() reads
# /proc/stat and raises, which hermes treats as no descendants. A foreground command
# still dies with its process group, but killing a background job signals only its
# bash parent, so its child can survive until it exits or the unit stops, and until
# then Lifecycle.Idle sees a process and the bot neither sleeps nor takes a quiet restart.
ProtectProc=invisible
ProcSubset=pid
PrivateIPC=yes

MemoryMax=1G
MemoryHigh=800M
# The quota stays at one core: a lower one slows cold starts, which have already
# hit a 10 s plugin timeout. The weight only matters when the CPU is contended.
CPUQuota=100%
CPUWeight=50
TasksMax=256

[Install]
WantedBy=multi-user.target
