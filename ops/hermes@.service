[Unit]
Description=Hermes bot %i
After=network-online.target druzhok.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=120
User=bot-%i
Group=bot-%i
# HERMES_HOME and all bot-specific vars come from the env file (Druzhok owns it).
EnvironmentFile=/etc/druzhok/%i.env
Environment=HOME=/data/tenants/%i/home
Environment=PATH=/opt/hermes/.venv/bin:/usr/local/bin:/usr/bin:/bin
# glibc gives each thread that mallocs its own 64 MB arena; hermes runs ~26
# threads, so an idle bot's RSS creeps up for days. Two arenas cap that.
Environment=MALLOC_ARENA_MAX=2
WorkingDirectory=/data/tenants/%i/workspace
ExecStart=/opt/hermes/.venv/bin/hermes gateway run
Restart=always
RestartSec=5
TimeoutStartSec=300
KillMode=mixed

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data/tenants/%i
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# A bot sees only its own processes in /proc.
ProtectProc=invisible
PrivateIPC=yes
# Host services a bot never needs. D-Bus (polkit behind it) and snapd answer any
# local user, and both have had privilege-escalation bugs. "-": absent is fine.
InaccessiblePaths=-/run/dbus -/run/snapd.socket -/run/snapd-snap.socket

# What a bot may look at (spec 2026-11-27-bot-sandbox-visibility-design.md):
# under /data its own dir and the runtime only, not the other bots' names,
# druzhok's source or ubuntu's home.
TemporaryFileSystem=/data:ro
BindReadOnlyPaths=/data/opt
BindPaths=/data/tenants/%i
# /run and /var hold other units' names, logs, host state. Kept: the socket
# READY=1 and the watchdog go to, and the resolver file /etc/resolv.conf links
# to. PrivateTmp still gives a private /var/tmp.
TemporaryFileSystem=/run:ro /var:ro
BindReadOnlyPaths=/run/systemd/notify /run/systemd/resolve/stub-resolv.conf
# Only its own cgroup: hermes sizes its cache from memory.max. On systemd 255
# ProtectControlGroups=yes would win over a tmpfs on the same path; the files
# are root's either way.
ProtectControlGroups=no
TemporaryFileSystem=/sys/fs/cgroup:ro
BindReadOnlyPaths=/sys/fs/cgroup/system.slice/system-hermes.slice/%n
# Platform config, units, firewall rules and helpers, as whole dirs so the next
# file put there is hidden too. EnvironmentFile= is read before these apply.
InaccessiblePaths=/etc/druzhok /etc/caddy /etc/systemd -/etc/nftables.d -/etc/nftables.conf
TemporaryFileSystem=/usr/local/sbin:ro
InaccessiblePaths=-/usr/local/lib/druzhok -/opt/druzhok-fetch
InaccessiblePaths=-/boot -/srv -/mnt -/media

MemoryMax=1G
MemoryHigh=800M
# The quota stays at one core: a lower one slows cold starts, which have already
# hit a 10 s plugin timeout. The weight only matters when the CPU is contended.
CPUQuota=100%
CPUWeight=50
TasksMax=256

[Install]
WantedBy=multi-user.target
