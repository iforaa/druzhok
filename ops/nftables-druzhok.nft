#!/usr/sbin/nft -f
# Egress policy for bot users. druzhok-ctl adds each bot's uid to @bot_uids.
#
# A bot may reach exactly three things: the druzhok proxy (LLM, search, page
# fetch — everything metered), the local DNS stub, and Telegram. Everything
# else is dropped and counted, so the model's terminal cannot curl the web
# around the proxy and a prompt-injected exfiltration has nowhere to go. Page reading happens
# in druzhok itself (docs/superpowers/specs/2026-09-05-web-fetch-service-design.md),
# whose user is not in the set.
#
# Telegram's published ranges (https://core.telegram.org/resources/cidr.txt);
# long polling and file downloads both go to api.telegram.org inside them.
table inet druzhok {
  set bot_uids { type uid; }

  # systemd-resolved's stub listeners (/etc/resolv.conf -> 127.0.0.53). The
  # upstream lookup is made by the systemd-resolve user, which is not a bot
  # uid. Port 53 to anywhere else would be an open tunnel out of the box.
  set resolvers4 {
    type ipv4_addr
    elements = { 127.0.0.53, 127.0.0.54 }
  }

  set telegram4 {
    type ipv4_addr
    flags interval
    elements = { 149.154.160.0/20, 91.108.4.0/22, 91.108.8.0/22, 91.108.12.0/22,
                 91.108.16.0/22, 91.108.20.0/22, 91.108.56.0/22, 185.76.151.0/24 }
  }

  set telegram6 {
    type ipv6_addr
    flags interval
    elements = { 2001:b28:f23d::/48, 2001:b28:f23f::/48, 2001:67c:4e8::/48, 2a0a:f280::/32 }
  }

  chain output {
    type filter hook output priority 0; policy accept;

    meta skuid != @bot_uids accept

    # Druzhok proxy
    ip daddr 127.0.0.1 tcp dport 4000 accept
    # DNS, local stub only
    ip daddr @resolvers4 udp dport 53 accept
    ip daddr @resolvers4 tcp dport 53 accept
    # Telegram, counted per uid
    ip daddr @telegram4 tcp dport 443 meter bot_tg { meta skuid counter } accept
    ip6 daddr @telegram6 tcp dport 443 meter bot_tg6 { meta skuid counter } accept
    # everything else: cloud metadata, other local services, the open web
    counter drop
  }
}
