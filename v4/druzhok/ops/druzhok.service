[Unit]
Description=Druzhok orchestrator (Phoenix)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/druzhok/v4/druzhok
# All prod env (MIX_ENV, DATABASE_PATH, DRUZHOK_HOST, HEX/MIX homes, secrets)
# lives in druzhok.env, shared with ops/druzhok-run.sh and ops/smoke.sh.
EnvironmentFile=/etc/druzhok/druzhok.env
Environment=PHX_SERVER=true PORT=4000
ExecStart=/bin/bash -lc '. /home/ubuntu/.asdf/asdf.sh && exec mix phx.server'
Restart=always
RestartSec=5
KillMode=mixed
# Tenant dirs are 0700 bot-<name> and hermes chmods its files 0600; Druzhok
# must still read/write config.yaml, AGENTS.md and serve sites/. It already
# holds root-equivalent power through sudo druzhok-ctl, so file caps add no
# new trust. druzhok-ctl start chowns the tree back to the bot.
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER

[Install]
WantedBy=multi-user.target
